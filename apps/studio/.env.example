# Replace the placeholder with your Vercel AI Gateway key. Never commit real credentials.
AI_GATEWAY_API_KEY=your_gateway_key_here
AI_MODEL=anthropic/claude-sonnet-5

# Or use a local Ollama instance instead:
# OLLAMA_BASE_URL=http://localhost:11434

{
  "servers": {
    "nextjs-studio": {
      "type": "http",
      "url": "http://localhost:3001/api/mcp"
    },
    "nextjs-web": {
      "type": "http",
      "url": "http://localhost:3000/api/mcp"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@microsoft/mcp-server-playwright"]
    }
  }
}
